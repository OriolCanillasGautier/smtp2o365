# =============================================================================
# SMTP Relay — Configuration
# Copy this file to ".env" and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Relay listen settings
# -----------------------------------------------------------------------------
#
# NOTE ON PORT 25: on Windows/Linux, binding to port 25 usually requires
# Administrator/root.  If it fails, set LISTEN_PORT=2525 and point your legacy
# services at that port instead.

LISTEN_HOST=0.0.0.0
LISTEN_PORT=25

# =============================================================================
# SENDING ACCOUNTS
# =============================================================================
#
# You can configure ONE or MANY O365 mailboxes.
#
#   Account 1 : O365_USERNAME        (always present, always the default)
#   Account 2 : O365_USERNAME_2
#   Account 3 : O365_USERNAME_3
#   ...       : O365_USERNAME_<n>
#
# Each account may have its own settings, using the same <n> suffix:
#
#   O365_PASSWORD_<n>        smtp_auth password / app password
#   AZURE_TENANT_ID_<n>      oauth2_graph override (optional)
#   AZURE_CLIENT_ID_<n>      oauth2_graph override (optional)
#   AZURE_CLIENT_SECRET_<n>  oauth2_graph override (optional)
#   O365_SEND_AS_<n>         extra local senders this mailbox handles
#   O365_SEND_AS_DOMAINS_<n> whole local domains this mailbox handles
#   FORWARD_TO_<n>           redirect target just for this mailbox
#
# Settings WITHOUT a suffix act as defaults for every account, e.g. a single
# AZURE_CLIENT_SECRET is shared by all accounts in the same tenant.
#
# HOW ROUTING WORKS
# -----------------
# When a legacy service connects and says "MAIL FROM:<1@some.local>", the relay
# picks the account in this order:
#
#   1. an account whose address IS the sender,
#   2. an account listing the sender in O365_SEND_AS_<n>,
#   3. an account listing the sender's domain in O365_SEND_AS_DOMAINS_<n>,
#   4. the account named by O365_DEFAULT_ACCOUNT (default: account 1).
#
# If the sender matches nothing and UNMATCHED_SENDER_POLICY=strict, the relay
# rejects it with "550 5.7.1 Sender has no relay account".
# -----------------------------------------------------------------------------

# --- Account 1 (required) ----------------------------------------------------
O365_USERNAME=relay@yourdomain.com

# --- Account 2 (optional) ----------------------------------------------------
# Uncomment both lines to enable a second sender mailbox.
# O365_USERNAME_2=invoices@yourdomain.com
# O365_SEND_AS_2=billing@company.local,erp@company.local

# Which account handles senders that match none of the rules above.
# Accepts an account number: 1, 2, 3 …  (omit = account 1)
# O365_DEFAULT_ACCOUNT=1

# fallback = use the default account | strict = reject with 550
UNMATCHED_SENDER_POLICY=fallback

# Delivery mode: choose ONE
#   smtp_auth    — Use O365_PASSWORD (app password or regular password)
#   oauth2_graph — Use AZURE_* credentials (app registration client secret)
AUTH_MODE=oauth2_graph

# -----------------------------------------------------------------------------
# Recipient handling — where accepted mail is actually delivered
# -----------------------------------------------------------------------------
#
# Three levels, most specific first:
#
#   FORWARD_TO_MAP   key:destination pairs; key is an exact sender OR a domain
#   FORWARD_TO_<n>   redirect target for one account
#   FORWARD_TO       global redirect target for everything
#
# If none matches, the ORIGINAL recipients are preserved.
#
# Examples:
#   FORWARD_TO=sink@yourdomain.com
#     → everything is redirected to one mailbox
#
#   FORWARD_TO_MAP=1@some.local:person.a@remote.com,2@some.local:person.b@remote.com
#     → mail from 1@some.local goes to person.a, mail from 2@some.local to person.b
#
#   FORWARD_TO_MAP=some.local:helpdesk@remote.com
#     → every sender in the some.local domain goes to helpdesk
#
# Leave all of them EMPTY to keep the original To/Cc recipients.
# FORWARD_TO=destination@yourdomain.com
# FORWARD_TO_MAP=sender1@company.local:person.a@remote.com,sender2@company.local:person.b@remote.com

# When true (strongly recommended), the From header is rewritten to the sending
# account's own address so the submission is accepted without explicit
# "Send As" permissions.  The original sender is preserved in Reply-To and
# X-Original-From headers, and the account used is recorded in X-Relay-Account.
REWRITE_FROM=true

# =============================================================================
# smtp_auth mode settings
# (Only needed if AUTH_MODE=smtp_auth)
# =============================================================================

# SMTP credentials for the O365 account.
#   • No MFA: use the regular account password
#   • Per-user MFA with App Passwords: paste the App Password (any length/format)
#   • Conditional Access: App Passwords may be unavailable — use oauth2_graph instead
#
# Add O365_PASSWORD_2=… for the second account, O365_PASSWORD_3=… for the third.
# O365_PASSWORD=your-password-or-app-password-here

O365_SMTP_HOST=smtp.office365.com
O365_SMTP_PORT=587

# =============================================================================
# oauth2_graph mode settings
# (Only needed if AUTH_MODE=oauth2_graph)
# =============================================================================
#
# How to set up in Microsoft Entra admin center:
#   1. App registrations → New registration (name: e.g. "smtp-relay")
#   2. Note the "Application (client) ID" and "Directory (tenant) ID"
#   3. Certificates & secrets → New client secret → copy the VALUE
#   4. API permissions → Add → Microsoft Graph → Application permissions
#      → Mail.Send → Add → Grant admin consent
#
# IMPORTANT — multiple accounts, one tenant
#   With the Mail.Send application permission the app can send as ANY mailbox in
#   the tenant, so ONE app registration and ONE client secret are enough for all
#   accounts in the same tenant.  The mailbox is chosen by the URL:
#
#       POST /v1.0/users/<O365_USERNAME>/sendMail
#
#   There is ONE access token per app registration — not one per mailbox.
#   Restrict the app to only the mailboxes it needs with an Exchange
#   application access policy (see README) instead of relying on tenant-wide
#   Mail.Send.
#
#   Only set AZURE_*_<n> overrides if an account lives in a DIFFERENT tenant or
#   uses a separate app registration.
# -----------------------------------------------------------------------------

# Directory (tenant) ID — shared by all accounts in the same tenant
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Application (client) ID
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret VALUE (long string with letters, digits, special characters)
AZURE_CLIENT_SECRET=your-client-secret-value-here

# Optional per-account overrides (different tenant / different app registration)
# AZURE_TENANT_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET_2=your-second-client-secret

# =============================================================================
# Allow-list settings
# =============================================================================

# Comma-separated list of exact sender addresses that are permitted.
# Add every local sender that appears in O365_SEND_AS_<n> here too.
# Example: ALLOWED_SENDERS=sqlreport@company.local,erp@company.local
ALLOWED_SENDERS=sender1@company.local,sender2@company.local

# Comma-separated list of sender domains.
# Combined with ALLOWED_SENDERS (either matching is enough).
# Add every domain that appears in O365_SEND_AS_DOMAINS_<n> here too.
# Example: ALLOWED_SENDER_DOMAINS=company.local,erp.internal
ALLOWED_SENDER_DOMAINS=company.local

# Comma-separated list of client IP addresses allowed to connect.
# Add the IPs of your SQL Server, ERP, or any other legacy service here.
# Leave EMPTY to disable IP filtering (only do this on a fully isolated network).
# Example: ALLOWED_CLIENT_IPS=127.0.0.1,::1,10.0.0.50,192.168.1.25
ALLOWED_CLIENT_IPS=127.0.0.1,::1,10.0.0.10

# =============================================================================
# Logging
# =============================================================================

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
